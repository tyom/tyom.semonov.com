{
  "name": "tyom-semonov-cv",
  "description": "Tyom Semonov: CV",
  "type": "module",
  "private": true,
  "version": "0.5.1",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --port 4000",
    "build": "vite build",
    "start": "vite preview",
    "create-pdf": "pnpm playwright test",
    "predeploy": "rm -rf build && pnpm build && echo tyom.semonov.com > build/CNAME",
    "deploy": "gh-pages -d build --dotfiles",
    "lint": "eslint --ignore-path .gitignore . && prettier --check .",
    "postinstall": "pnpm exec playwright install chromium --with-deps",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@lucide/svelte": "^0.536.0",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/vite": "^4.1.11",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "glob": "^11.0.3",
    "is-plain-object": "^5.0.0",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "posthog-js": "^1.258.5",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/svelte": "^8.6.0",
    "@storybook/sveltekit": "^8.6.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.21.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-storybook": "^0.8.0",
    "eslint-plugin-svelte": "^3.9.2",
    "gh-pages": "6.3.0",
    "playwright": "^1.53.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "storybook": "^8.6.0",
    "svelte": "^5.33.19",
    "svelte-loader": "^3.2.4",
    "svelte-preprocess": "^6.0.3",
    "vite": "^6.3.5"
  }
